{
  "name": "ui-auditor",
  "version": "0.1.0",
  "description": "Paste one URL, get an evidence-backed UX, engineering, SDET, accessibility and domain audit with Good/Better redesigns.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "npm run build:web && tsx src/server/index.ts",
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "npm run build:web && tsc -p tsconfig.json --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "audit": "tsx src/scripts/audit.ts",
    "fixtures": "tsx fixtures/serve.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@fastify/static": "^10.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
