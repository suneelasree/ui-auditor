# Claude
# Leave empty to run rule-based checks only (AI agents and design mockups are skipped).
ANTHROPIC_API_KEY=
UIA_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
UIA_EFFORT=high

# Web UI
PORT=3000
# Extra host names the Web UI may be reached on (comma-separated). localhost and 127.0.0.1 are always allowed.
UIA_ALLOWED_HOSTS=

# Optional login for auditing logged-in pages (use test/staging accounts only)
UIA_LOGIN_USER=
UIA_LOGIN_PASSWORD=

# Optional: GitHub Issues export
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Optional: Jira export
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug
# Set to false if your Jira project rejects the priority field on create
JIRA_SET_PRIORITY=true
